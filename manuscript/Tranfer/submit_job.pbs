#!/bin/bash

# Activate the conda environment
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# Change to the directory where qsub was called
cd ~/LTH/manuscript/Tranfer/ || exit 1

# Debug: Print variable values
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "EXPERIMENT=$EXPERIMENT"
echo "FLAG=$FLAG"

# Check for unset variables
if [ -z "$MODEL" ] || [ -z "$DATASET" ] || [ -z "$EXPERIMENT" ] || [ -z "$FLAG" ]; then
  echo "Error: One or more required variables (MODEL, DATASET, EXPERIMENT, FLAG) are not set." >&2
  exit 1
fi

# Echo the command
echo "Executing: ~/env/lth_env/bin/python transfer.py --model $MODEL --dataset $DATASET --experiment $EXPERIMENT --$FLAG"

# Run the command and redirect output to file
~/env/lth_env/bin/python transfer.py \
  --model "$MODEL" \
  --dataset "$DATASET" \
  --experiment "$EXPERIMENT" \
  --"$FLAG" \
  > "${MODEL}_${DATASET}_${EXPERIMENT}_${FLAG}_run.txt"
