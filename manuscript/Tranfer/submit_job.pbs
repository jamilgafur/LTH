#!/bin/bash

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

# --- Default the scorer universe (keeps legacy behavior/paths when unset) ---
SCORER="${SCORER:-local_dev}"

# --- Debug: Show variable values ---
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "EXPERIMENT=$EXPERIMENT"
echo "QUANT=$QUANT"
echo "PRETRAIN=$PRETRAIN"
echo "EPOCHS=$EPOCHS"
echo "SCORER=$SCORER"

# --- Check for required variables ---
if [ -z "$MODEL" ] || [ -z "$DATASET" ] || [ -z "$EXPERIMENT" ] || [ -z "$QUANT" ] || [ -z "$PRETRAIN" ] || [ -z "$EPOCHS" ]; then
    echo "Error: One or more required environment variables (MODEL, DATASET, EXPERIMENT, QUANT, PRETRAIN, EPOCHS) are not set." >&2
    exit 1
fi

# --- Scorer-aware log filename (legacy name when scorer is default) ---
SCORER_TAG=""
if [ "$SCORER" != "local_dev" ]; then
    SCORER_TAG="_scorer${SCORER}"
fi

# --- Prepare output file ---
OUTPUT_FILE="${MODEL}_${DATASET}_${EXPERIMENT}_JF_${QUANT}${SCORER_TAG}_pre${PRETRAIN}_ep${EPOCHS}_run.txt"

# Remove existing output file if it exists
if [ -f "$OUTPUT_FILE" ]; then
    echo "Removing existing output file: $OUTPUT_FILE"
    # rm "$OUTPUT_FILE"
fi

# --- Check if quant flag should be added ---
QUANT_FLAG=""
if [ "$QUANT" == "True" ]; then
    QUANT_FLAG="--quant"
fi

# --- Run the Python script ---
echo "Executing: ~/env/lth_env/bin/python transfer.py --model $MODEL --dataset $DATASET --experiment \"$EXPERIMENT\" --pretrain $PRETRAIN --epochs $EPOCHS --scorer $SCORER $QUANT_FLAG"

time ~/env/lth_env/bin/python transfer.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --experiment "$EXPERIMENT" \
    --pretrain "$PRETRAIN" \
    --epochs "$EPOCHS" \
    --scorer "$SCORER" \
    $QUANT_FLAG > "$OUTPUT_FILE" 2>&1

time ~/env/lth_env/bin/python Journal_plot.py --epoch "$EPOCHS" --pretrain "$PRETRAIN" --scorer "$SCORER" >> "$OUTPUT_FILE" 2>&1

echo "Job finished."
