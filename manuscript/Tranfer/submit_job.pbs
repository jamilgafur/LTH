#!/bin/bash

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

# --- Debug: Show variable values ---
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "EXPERIMENT=$EXPERIMENT"
echo "FLAG=$FLAG"
echo "QUANT=$QUANT"
echo "PRETRAIN=$PRETRAIN"
echo "EPOCHS=$EPOCHS"

# --- Check for required variables ---
if [ -z "$MODEL" ] || [ -z "$DATASET" ] || [ -z "$EXPERIMENT" ] || [ -z "$FLAG" ] || [ -z "$QUANT" ] || [ -z "$PRETRAIN" ] || [ -z "$EPOCHS" ]; then
    echo "Error: One or more required environment variables (MODEL, DATASET, EXPERIMENT, FLAG, QUANT, PRETRAIN, EPOCHS) are not set." >&2
    exit 1
fi

# --- Prepare output file ---
OUTPUT_FILE="${MODEL}_${DATASET}_${EXPERIMENT}_${FLAG}_${QUANT}_pre${PRETRAIN}_ep${EPOCHS}_run.txt"

# Remove existing output file if it exists
if [ -f "$OUTPUT_FILE" ]; then
    echo "Removing existing output file: $OUTPUT_FILE"
    # rm "$OUTPUT_FILE"
fi

# --- Check if quant flag should be added ---
QUANT_FLAG=""
if [ "$QUANT" == "True" ]; then
    QUANT_FLAG="--quant"
fi

# --- Run the Python script ---
echo "Executing: ~/env/lth_env/bin/python transfer.py --model $MODEL --dataset $DATASET --experiment \"$EXPERIMENT\" --$FLAG --pretrain $PRETRAIN --epochs $EPOCHS $QUANT_FLAG"

time ~/env/lth_env/bin/python transfer.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --experiment "$EXPERIMENT" \
    --"$FLAG" \
    --pretrain "$PRETRAIN" \
    --epochs "$EPOCHS" \
    $QUANT_FLAG > "$OUTPUT_FILE" 2>&1

echo "Job finished."