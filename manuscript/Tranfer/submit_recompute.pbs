#!/bin/bash
#$ -l mem_free=64G

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

python -c "import torch;raise SystemExit(0 if torch.cuda.is_available() else 1)" || {
  echo "[FATAL] $(hostname): no usable GPU — exiting fast instead of evaluating for hours on CPU" >&2
  exit 99
}

# --- 1. Fix the numbers: evaluate every finished checkpoint on the test set ---
# Corrects best_acc/final_accuracy in */metrics/merged_metrics.json (originals
# kept as .bak; old train-based values preserved as train_best_acc). Eval only,
# no retraining.
echo "Executing: recompute_test_acc.py ."
time ~/env/lth_env/bin/python recompute_test_acc.py . > recompute_test_acc.log 2>&1

# --- 2. Regenerate the tex tables and tradeoff plots from the corrected JSONs ---
echo "Executing: plot_tradeoff.py"
time ~/env/lth_env/bin/python plot_tradeoff.py > plot_tradeoff.log 2>&1

echo "Job finished."
