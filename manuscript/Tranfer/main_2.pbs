#!/bin/bash

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

# --- Debug: Show variable values ---
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "EXPERIMENT=$EXPERIMENT"
echo "EPOCHS=$EPOCHS"
echo "COLLAPSE_START=$COLLAPSE_START"
echo "COLLAPSE_END=$COLLAPSE_END"
echo "QUANT=$QUANT"


# --- Prepare output file ---
OUTPUT_FILE="${MODEL}_${DATASET}_${EXPERIMENT}_${EPOCHS}_${COLLAPSE_START}_${COLLAPSE_END}_${QUANT}_run.txt"

# --- Check if quant flag should be added ---
QUANT_FLAG=""
if [ "$QUANT" == "True" ]; then
    QUANT_FLAG="--quant"
fi

# --- Run the Python script ---
echo "Executing: python main_2.py --model $MODEL -dataset $DATASET -epochs $EPOCHS -collapse_start $COLLAPSE_START -collapse_end $COLLAPSE_END $QUANT_FLAG"

~/env/lth_env/bin/python main_2.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --epochs "$EPOCHS" \
    --collapse_start "$COLLAPSE_START" \
    --collapse_end "$COLLAPSE_END" \
    $QUANT_FLAG \
    > "$OUTPUT_FILE" 2>&1
