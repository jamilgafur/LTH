#!/bin/bash
#PBS -N adversarial_analysis
#PBS -q all.q
#PBS -l ngpus=1
#PBS -o logs/adversarial_%J.log
#PBS -e logs/adversarial_%J.err
#PBS -v MODEL,DATASET,ATTACK,PHASE,OUTPUT_DIR

# Adversarial Analysis HPC Submission Script
# 
# Usage: qsub -v MODEL="VGG16",DATASET="Cifar10",ATTACK="PGD",PHASE="generate",OUTPUT_DIR="adversarial_results" adversarial_hpc_submit.pbs
#
# Parameters:
#   MODEL      - Model architecture (VGG16, RegNetX_400MF, ConvNeXt, InceptionNet, MobileNet, XceptionNet)
#   DATASET    - Dataset (Cifar10, Cifar100, imagenet, tinyimagenet)
#   ATTACK     - Attack type (PGD, FGSM, IFGSM, BIM, APGD, CW, DeepFool)
#   PHASE      - Phase to run (generate, analyze, plot)
#   OUTPUT_DIR - Output directory for results (default: adversarial_results)

set -e

# Load required modules (adjust based on your HPC setup)
module load cuda/11.8
module load python/3.10

# Navigate to script directory
cd "$(dirname "$0")"

# Create logs directory if it doesn't exist
mkdir -p logs

# Check required variables.
if [ -z "$PHASE" ] || [ -z "$OUTPUT_DIR" ]; then
    echo "Error: PHASE and OUTPUT_DIR are required environment variables." >&2
    exit 1
fi

# Prepare a txt output file similar to submit_job.pbs.
if [ "$PHASE" = "generate" ]; then
    if [ -z "$MODEL" ] || [ -z "$DATASET" ] || [ -z "$ATTACK" ]; then
        echo "Error: MODEL, DATASET and ATTACK are required for generate phase." >&2
        exit 1
    fi
    OUTPUT_FILE="${MODEL}_${DATASET}_${ATTACK}_${PHASE}_run.txt"
else
    OUTPUT_FILE="adversarial_${PHASE}_run.txt"
fi

echo "========================================================================"
echo "Adversarial Analysis on HPC"
echo "========================================================================"
echo "Model:       $MODEL"
echo "Dataset:     $DATASET"
echo "Attack:      $ATTACK"
echo "Phase:       $PHASE"
echo "Output Dir:  $OUTPUT_DIR"
echo "========================================================================"
echo "Job ID:      $PBS_JOBID"
echo "Hostname:    $(hostname)"
echo "GPU Device:  $(nvidia-smi --query-gpu=index,name --format=csv,noheader)"
echo "========================================================================"

# Activate virtual environment if available
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
fi

# Run adversarial analysis with command line adapted by phase.
CMD=(python adversarial_analysis.py --mode "$PHASE" --output-dir "$OUTPUT_DIR")
if [ "$PHASE" = "generate" ]; then
    CMD+=(--model "$MODEL" --dataset "$DATASET" --attack "$ATTACK")
fi

echo "Executing: ${CMD[*]}"
echo "Writing output to: $OUTPUT_FILE"

time "${CMD[@]}" > "$OUTPUT_FILE" 2>&1

echo "========================================================================"
echo "Job completed successfully at $(date)"
echo "========================================================================"
