#!/bin/bash
#PBS -N adversarial_analysis
#PBS -q all.q
#PBS -l ngpus=1
#PBS -o logs/adversarial_%J.log
#PBS -e logs/adversarial_%J.err
#PBS -v MODEL,DATASET,ATTACK,KIND,PHASE,OUTPUT_DIR,EPSILON_ATTACKS,RESULT_DIRS,CKA_MAX_SAMPLES,CKA_MAX_LAYERS,FORCE_RERUN

set -e

# --- Environment Setup ---
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

# Create logs directory if it doesn't exist
mkdir -p logs

# Check required variables
if [ -z "$PHASE" ] || [ -z "$OUTPUT_DIR" ]; then
    echo "Error: PHASE and OUTPUT_DIR are required environment variables." >&2
    exit 1
fi

# Normalize optional variables
MODEL=${MODEL:-ALL}
DATASET=${DATASET:-ALL}
ATTACK=${ATTACK:-ALL}
KIND=${KIND:-ALL}

# Prepare a txt output file that is unique per result directory
# Ensure the output directory exists
mkdir -p "$OUTPUT_DIR"

# Prefer node-local scratch for temporary artifact writes when the scheduler provides it.
# Otherwise keep temporary artifacts in the job's working directory so the save path stays local.
if [ -n "${TMPDIR:-}" ] && [ -d "${TMPDIR}" ]; then
    export LTH_SAVE_TMPDIR="${TMPDIR}/lth_save_tmp_${PBS_JOBID:-manual}"
else
    export LTH_SAVE_TMPDIR="${PWD}/lth_save_tmp_${PBS_JOBID:-manual}"
fi
# Log the temporary directory being used for artifact staging
echo "[INFO] Using temporary save directory: $LTH_SAVE_TMPDIR"
mkdir -p "$LTH_SAVE_TMPDIR"

# Fail fast if output storage is not writable or nearly full.
if ! touch "${OUTPUT_DIR}/.write_test_${PBS_JOBID:-manual}" 2>/dev/null; then
    echo "[ERROR] Output directory is not writable: ${OUTPUT_DIR}" >&2
    exit 1
fi
rm -f "${OUTPUT_DIR}/.write_test_${PBS_JOBID:-manual}"

echo "Output filesystem usage:"
df -h "$OUTPUT_DIR" || true
echo "Temp filesystem usage:"
df -h "$LTH_SAVE_TMPDIR" || true

if [ "$PHASE" = "generate" ]; then
    if [ "$MODEL" = "ALL" ] || [ "$DATASET" = "ALL" ] || [ "$ATTACK" = "ALL" ]; then
        echo "Error: MODEL, DATASET and ATTACK are required for generate phase." >&2
        exit 1
    fi
    # Include the result folder name in the filename to avoid collisions across runs
    OUTPUT_FILE="${OUTPUT_DIR}/${MODEL}_${DATASET}_${ATTACK}_${KIND}_${PHASE}_run.txt"
else
    # For non‑generate phases use a generic name but scoped to the result folder
    OUTPUT_FILE="${OUTPUT_DIR}/adversarial_${PHASE}_run.txt"
fi

# -----------------------------------------------------------------------------
# Idempotency guards: skip if this unit is already running or already completed.
# Set FORCE_RERUN=1 in the qsub environment to bypass these checks.
# -----------------------------------------------------------------------------
STATUS_DIR="${OUTPUT_DIR}/.job_status"
mkdir -p "$STATUS_DIR"

if [ "$PHASE" = "generate" ]; then
    JOB_KEY="${MODEL}_${DATASET}_${ATTACK}_${KIND}_${PHASE}"
else
    JOB_KEY="${PHASE}"
fi

DONE_MARKER="${STATUS_DIR}/${JOB_KEY}.done"
LOCK_MARKER="${STATUS_DIR}/${JOB_KEY}.lock"

if [ "${FORCE_RERUN:-0}" != "1" ]; then
    if [ -f "$LOCK_MARKER" ]; then
        echo "[SKIP] Active lock detected for ${JOB_KEY}: $LOCK_MARKER"
        echo "[SKIP] Another job is already processing this unit. Exiting without overwrite."
        exit 0
    fi

    if [ -f "$DONE_MARKER" ]; then
        echo "[SKIP] Completion marker detected for ${JOB_KEY}: $DONE_MARKER"
        echo "[SKIP] This unit was already processed. Exiting without overwrite."
        exit 0
    fi

    if [ -s "$OUTPUT_FILE" ]; then
        echo "[SKIP] Existing output detected: $OUTPUT_FILE"
        echo "[SKIP] Treating as already processed to prevent accidental overwrite."
        echo "[SKIP] Use FORCE_RERUN=1 if you intentionally want to regenerate."
        exit 0
    fi
fi

# Mark this unit as in-progress and always release lock on exit.
echo "${PBS_JOBID:-unknown}" > "$LOCK_MARKER"
trap 'rm -f "$LOCK_MARKER"' EXIT

echo "========================================================================"
echo "Adversarial Analysis on HPC"
echo "========================================================================"
echo "Model:       $MODEL"
echo "Dataset:     $DATASET"
echo "Attack:      $ATTACK"
echo "Kind:        $KIND"
echo "Phase:       $PHASE"
echo "Output Dir:  $OUTPUT_DIR"
echo "Save TMP:    $LTH_SAVE_TMPDIR"
echo "========================================================================"
echo "Job ID:      $PBS_JOBID"
echo "Hostname:    $(hostname)"
echo "GPU Device:  $(nvidia-smi --query-gpu=index,name --format=csv,noheader || echo 'No GPU found')"
echo "========================================================================"

# Run adversarial analysis using the package entrypoint
CMD=(~/env/lth_env/bin/python -m manuscript.Tranfer.adversarial_analysis --mode "$PHASE" --output-dir "$OUTPUT_DIR")
case "$PHASE" in
    generate)
        CMD+=(--model "$MODEL" --dataset "$DATASET" --attack "$ATTACK")
        if [ "$KIND" != "ALL" ]; then
            CMD+=(--kind "$KIND")
        fi
        ;;
    analyze)
        if [ "$MODEL" != "ALL" ]; then CMD+=(--model "$MODEL"); fi
        if [ "$DATASET" != "ALL" ]; then CMD+=(--dataset "$DATASET"); fi
        if [ "$ATTACK" != "ALL" ]; then CMD+=(--attack "$ATTACK"); fi
        if [ "$KIND" != "ALL" ]; then CMD+=(--kind "$KIND"); fi
        ;;
    plot)
        # plot phase consumes existing CSV outputs.
        ;;
    compare)
        # compare phase builds explainability/profile tables from summary.csv.
        if [ -n "${RESULT_DIRS:-}" ]; then
            # shellcheck disable=SC2086
            CMD+=(--result-dirs $RESULT_DIRS)
        fi
        ;;
    gradient_sim)
        if [ "$MODEL" != "ALL" ]; then CMD+=(--model "$MODEL"); fi
        if [ "$DATASET" != "ALL" ]; then CMD+=(--dataset "$DATASET"); fi
        if [ "$KIND" != "ALL" ]; then CMD+=(--kind "$KIND"); fi
        ;;
    epsilon_sweep)
        if [ "$MODEL" != "ALL" ]; then CMD+=(--model "$MODEL"); fi
        if [ "$DATASET" != "ALL" ]; then CMD+=(--dataset "$DATASET"); fi
        if [ "$KIND" != "ALL" ]; then CMD+=(--kind "$KIND"); fi
        # EPSILON_ATTACKS env var: space-separated list of attacks, e.g. "PGD FGSM BIM"
        if [ -n "${EPSILON_ATTACKS:-}" ]; then
            # shellcheck disable=SC2086
            CMD+=(--epsilon-attacks $EPSILON_ATTACKS)
        fi
        ;;
    statistics)
        # RESULT_DIRS env var: space-separated list of output dirs
        if [ -n "${RESULT_DIRS:-}" ]; then
            # shellcheck disable=SC2086
            CMD+=(--result-dirs $RESULT_DIRS)
        fi
        ;;
    cka)
        if [ "$MODEL" != "ALL" ]; then CMD+=(--model "$MODEL"); fi
        if [ "$DATASET" != "ALL" ]; then CMD+=(--dataset "$DATASET"); fi
        if [ "$KIND" != "ALL" ]; then CMD+=(--kind "$KIND"); fi
        if [ -n "${CKA_MAX_SAMPLES:-}" ]; then CMD+=(--cka-max-samples "$CKA_MAX_SAMPLES"); fi
        if [ -n "${CKA_MAX_LAYERS:-}" ]; then CMD+=(--cka-max-layers "$CKA_MAX_LAYERS"); fi
        ;;
    compute_tradeoff)
        if [ "$MODEL" != "ALL" ]; then CMD+=(--model "$MODEL"); fi
        if [ "$DATASET" != "ALL" ]; then CMD+=(--dataset "$DATASET"); fi
        if [ "$KIND" != "ALL" ]; then CMD+=(--kind "$KIND"); fi
        ;;
    correlations)
        # Correlations are derived from generated CSV outputs.
        ;;
esac

echo "Executing: ${CMD[*]}"
echo "Writing output to: $OUTPUT_FILE"

time "${CMD[@]}" > "$OUTPUT_FILE" 2>&1

printf "job_id=%s\noutput_file=%s\ncompleted_at=%s\n" \
    "${PBS_JOBID:-unknown}" \
    "$OUTPUT_FILE" \
    "$(date '+%Y-%m-%d %H:%M:%S')" > "$DONE_MARKER"

echo "========================================================================"
echo "Job completed successfully at $(date)"
echo "========================================================================"
