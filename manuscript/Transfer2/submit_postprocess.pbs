#!/bin/bash

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Transfer2/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Transfer2/"
    exit 1
}

# --- Default quant flag (analyzes the non-quant universe when unset) ---
QUANT="${QUANT:-False}"

# --- Debug: Show variable values ---
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "QUANT=$QUANT"

# --- Check for required variables ---
if [ -z "$MODEL" ] || [ -z "$DATASET" ]; then
    echo "Error: One or more required environment variables (MODEL, DATASET) are not set." >&2
    exit 1
fi

# --- Check if quant flag should be added ---
QUANT_FLAG=""
if [ "$QUANT" == "True" ]; then
    QUANT_FLAG="--quant"
fi

# --- Prepare output file ---
OUTPUT_FILE="postprocess_${MODEL}_${DATASET}_quant${QUANT}.log"

# --- Run the Python script (epoch configs are derived from checkpoint directory names) ---
echo "Executing: ~/env/lth_env/bin/python main.py --model $MODEL --dataset $DATASET $QUANT_FLAG"

time ~/env/lth_env/bin/python main.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    $QUANT_FLAG > "$OUTPUT_FILE" 2>&1

echo "Job finished."
