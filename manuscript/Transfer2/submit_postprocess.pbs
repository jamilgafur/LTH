#!/bin/bash
#PBS -N cka_postprocess
#PBS -q all.q
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -o logs/cka_%J.log
#PBS -e logs/cka_%J.err
#PBS -v MODEL,DATASET

set -e

# --- Environment Setup ---
echo "Activating conda environment..."
# Assuming conda is initialized; otherwise source conda.sh first
eval "$(conda shell.bash hook)"
conda activate ~/env/lth_env/

echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Tranfer/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Tranfer/"
    exit 1
}

# Create logs directory if it doesn't exist
mkdir -p logs

# --- Check for required variables ---
if [ -z "$MODEL" ] || [ -z "$DATASET" ]; then
    echo "Error: MODEL and DATASET environment variables are required." >&2
    exit 1
fi

echo "========================================================================"
echo "CKA Post-Processing on HPC"
echo "========================================================================"
echo "Model:       $MODEL"
echo "Dataset:     $DATASET"
echo "Job ID:      $PBS_JOBID"
echo "Hostname:    $(hostname)"
echo "GPU Device:  $(nvidia-smi --query-gpu=index,name --format=csv,noheader || echo 'No GPU found')"
echo "========================================================================"

# --- Run the Python script ---
OUTPUT_FILE="cka_run_${MODEL}_${DATASET}.log"

echo "Executing: ~/env/lth_env/bin/python post_process_cka.py --model $MODEL --dataset $DATASET"

time ~/env/lth_env/bin/python post_process_cka.py \
    --model "$MODEL" \
    --dataset "$DATASET" > "$OUTPUT_FILE" 2>&1

echo "Job finished."