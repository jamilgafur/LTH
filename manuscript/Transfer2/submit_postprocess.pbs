#!/bin/bash
#$ -l mem_free=64G

# --- Environment Setup ---
echo "Activating conda environment..."
conda activate ~/env/lth_env/
echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

# --- Move to script directory ---
cd ~/LTH/manuscript/Transfer2/ || {
    echo "Failed to change directory to ~/LTH/manuscript/Transfer2/"
    exit 1
}

python -c "import torch;raise SystemExit(0 if torch.cuda.is_available() else 1)" || {
  echo "[FATAL] $(hostname): no usable GPU — exiting fast instead of training 3 days on CPU" >&2
  exit 99
}

# --- Default quant flag (analyzes the non-quant universe when unset) ---
QUANT="${QUANT:-False}"

# --- Measurement reps (noisy power/latency numbers get median depth) ---
REPS="${REPS:-1}"

# --- Analysis depth: 'full' = epsilon sweeps + calibration + OOD (+ CIFAR-C
#     with --corruptions-dir). Dissertation data needs 'full'.
ANALYSIS="${ANALYSIS:-full}"

# --- Debug: Show variable values ---
echo "MODEL=$MODEL"
echo "DATASET=$DATASET"
echo "QUANT=$QUANT"
echo "PRETRAIN=$PRETRAIN"
echo "EPOCHS=$EPOCHS"
echo "REPS=$REPS"
echo "ANALYSIS=$ANALYSIS"

# --- Check for required variables ---
if [ -z "$MODEL" ] || [ -z "$DATASET" ] || [ -z "$PRETRAIN" ] || [ -z "$EPOCHS" ]; then
    echo "Error: One or more required environment variables (MODEL, DATASET, PRETRAIN, EPOCHS) are not set." >&2
    exit 1
fi

# --- Check if quant flag should be added ---
QUANT_FLAG=""
if [ "$QUANT" == "True" ]; then
    QUANT_FLAG="--quant"
fi

# --- Prepare output file ---
OUTPUT_FILE="postprocess_${MODEL}_${DATASET}_pre${PRETRAIN}_ep${EPOCHS}_quant${QUANT}.log"

# --- Run the Python script (single epoch config per job; --pre/--post filter discovery) ---
echo "Executing: ~/env/lth_env/bin/python main.py --model $MODEL --dataset $DATASET --pre $PRETRAIN --post $EPOCHS --reps $REPS $QUANT_FLAG"

time ~/env/lth_env/bin/python main.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --pre "$PRETRAIN" \
    --post "$EPOCHS" \
    --reps "$REPS" \
    --analysis "$ANALYSIS" \
    $QUANT_FLAG > "$OUTPUT_FILE" 2>&1

# --- CKA strip/drift audit, appended to this submission's log ---
echo "--- CKA strip/drift audit ($(date)) ---" >> "$OUTPUT_FILE"
~/env/lth_env/bin/python diagnose_cka.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --pre "$PRETRAIN" \
    --post "$EPOCHS" >> "$OUTPUT_FILE" 2>&1 || echo "[WARN] diagnose_cka.py exited nonzero (see above)" >> "$OUTPUT_FILE"

echo "Job finished."
