#!/bin/bash

# --- SGE Directives (UIowa Argon) ---
#$ -N cka_postprocess
#$ -q all.q
#$ -l ngpus=1
#$ -pe smp 4
#$ -l mem_free=32G
#$ -l h_rt=12:00:00
#$ -cwd
#$ -o logs/cka_$JOB_ID.log
#$ -e logs/cka_$JOB_ID.err
#$ -v MODEL,DATASET,RETRY_COUNT

set -e

# --- Environment Setup ---
echo "Activating conda environment..."
eval "$(conda shell.bash hook)"
conda activate ~/env/lth_env/

echo "Loaded CUDA and GCC modules..."
module load cuda/11.1.1_gcc-9.3.0
module load gcc/9.3.0

cd ~/LTH/manuscript/Transfer2/ || exit 1
mkdir -p logs

if [ -z "$MODEL" ] || [ -z "$DATASET" ]; then
    echo "Error: MODEL and DATASET variables are required." >&2
    exit 1
fi

RETRY_COUNT=${RETRY_COUNT:-0}
MAX_RETRIES=5

# --- GPU Health Check & Auto-Resubmission ---
GPU_VALID=true
if ! nvidia-smi > /dev/null 2>&1; then
    GPU_VALID=false
elif ! ~/env/lth_env/bin/python -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)" 2>/dev/null; then
    GPU_VALID=false
fi

if [ "$GPU_VALID" = false ]; then
    if [ "$RETRY_COUNT" -lt "$MAX_RETRIES" ]; then
        NEXT_RETRY=$((RETRY_COUNT + 1))
        BAD_NODE=$(hostname)
        echo "[RESUBMIT] Dead GPU driver detected on $BAD_NODE. Blacklisting node and resubmitting..."
        
        # Resubmit explicitly excluding the broken node using SGE syntax
        qsub -v MODEL="$MODEL",DATASET="$DATASET",RETRY_COUNT="$NEXT_RETRY" -l h=\!$BAD_NODE submit_postprocess.pbs
        exit 0
    else
        echo "[ERROR] Max retries reached." >&2
        exit 1
    fi
fi

echo "========================================================================"
echo "CKA Post-Processing on HPC (SGE)"
echo "========================================================================"
echo "Model:       $MODEL"
echo "Dataset:     $DATASET"
echo "Job ID:      $JOB_ID"
echo "Hostname:    $(hostname)"
echo "GPU Device:  $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "========================================================================"

OUTPUT_FILE="cka_run_${MODEL}_${DATASET}.log"

time ~/env/lth_env/bin/python main.py \
    --model "$MODEL" \
    --dataset "$DATASET" > "$OUTPUT_FILE" 2>&1

echo "Job finished."
